# ── LearnHarness API Keys ──────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.  Only the providers you use
# need entries — the app resolves from whatever is present at request time.
#
# Model providers (required for any chat/agent features):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=...
# GROQ_API_KEY=gsk_...
#
# Additional providers (optional — uncomment to enable):
# DEEPGRAM_API_KEY=...        # Speech-to-text (dictation)
# TAVILY_API_KEY=tvly-...     # Web search (researcher sub-agent)
# BRAVE_API_KEY=...           # Web search (alternative to Tavily)
# HF_TOKEN=hf_...             # Hugging Face
# MISTRAL_API_KEY=...
# NVIDIA_API_KEY=...
# FIREWORKS_API_KEY=...
# CEREBRAS_API_KEY=...
# DEEPSEEK_API_KEY=...
# META_API_KEY=...
# TOGETHER_API_KEY=...
# ZAI_API_KEY=...
