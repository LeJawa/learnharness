# Secrets & dev data (belt-and-braces alongside next.config.ts excludes)
data/
auth.json
.env
.env.local
.env.*.local
*.credentials.json

# Git
.git
.gitignore

# Node
node_modules
.next
dist

# Editor / IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docs & tests (not needed in production)
docs/
tests/

# NOTE: electron/ is REQUIRED in the build context — src/server/web-subscriptions.ts
# imports runtime .cjs modules from it (chatgpt.cjs, subscriptions.cjs, *-ipc.cjs).
# Only the Electron shell entrypoints are build-only, but they are small and
# the standalone trace ignores them anyway.
electron-builder.yml

# Dev tooling
*.log
npm-debug.log*
